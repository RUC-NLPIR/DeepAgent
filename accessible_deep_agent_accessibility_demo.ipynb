    "        .ax-card { border: 1px solid #222; background: #080808; padding: 20px; margin: 15px 0; border-left: 5px solid var(--ax-neon); border-radius: 4px; }\n",
    "        .ax-title { font-family: 'Space Mono'; color: var(--ax-neon); font-size: 1em; text-transform: uppercase; margin-bottom: 12px; border-bottom: 1px solid #1a1a1a; padding-bottom: 5px; }\n",
    "        .ax-stat { color: var(--ax-cyan); font-family: 'Space Mono'; font-weight: bold; }\n",
    "        .scroll-pane { height: 200px; overflow-y: auto; font-family: 'Space Mono', monospace; font-size: 11px; background: #000; padding: 10px; border: 1px solid #1a1a1a; color: #aaa; margin-top: 10px; }\n",
    "        .ax-table { width: 100%; border-collapse: collapse; font-family: 'Space Mono'; font-size: 11px; margin-top: 10px; }\n",
    "        .ax-table th { color: var(--ax-neon); text-align: left; border-bottom: 1px solid #333; padding: 8px; }\n",
    "        .ax-table td { border-bottom: 1px solid #111; padding: 8px; color: #ccc; }\n",
    "    </style>\n",
    "    <div class='ax-header'>ARTIFEX LABS // ADA v4.5 // AETHER KERNEL (JAN-2026)</div>\n",
    "    \"\"\"))\n",
    "\n",
