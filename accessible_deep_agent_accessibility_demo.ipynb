    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "\n",
    "def inject_artifex_style():\n",
    "    display(HTML(\"\"\"\n",
    "    <style>\n",
    "        @import url('https://fonts.googleapis.com/css2?family=Space+Mono&family=Outfit:wght@300;700&display=swap');\n",
    "        :root { --ax-bg: #030303; --ax-neon: #00ffa3; --ax-cyan: #00e5ff; --ax-text: #f0f0f0; --ax-red: #ff3e3e; --ax-gold: #ffcc00; }\n",
